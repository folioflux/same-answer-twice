{
  "name": "@folioflux/same-answer-twice",
  "version": "0.1.0",
  "description": "Check that an AI agent gives the same answer twice: run a question N times, compare structured outputs and numbers with stable hashing, and get a clear diff report.",
  "keywords": [
    "ai",
    "agents",
    "determinism",
    "reproducibility",
    "eval",
    "diff",
    "stable-hash"
  ],
  "homepage": "https://github.com/folioflux/same-answer-twice#readme",
  "bugs": {
    "url": "https://github.com/folioflux/same-answer-twice/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/folioflux/same-answer-twice.git"
  },
  "license": "MIT",
  "author": "FolioFlux",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "same-answer-twice": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "examples": "node examples/run-examples.mjs",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.8",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
